{
  "manifest_version": 3,
  "name": "Tab Number Title Prefix",
  "version": "1.0",
  "description": "Prefixes each tab's title with its position number, so you know which Ctrl/Cmd+Number shortcut jumps to it.",
  "permissions": ["tabs"],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Tab Number Title Prefix",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
